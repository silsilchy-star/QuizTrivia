{
  "name": "quiztrivia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-image-check.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "validate": "node scripts/validate.mjs",
    "build:seed": "node scripts/build-seed.mjs",
    "review": "node scripts/review.mjs",
    "db:local": "npm run build:seed && wrangler d1 execute quiztrivia --local --file=db/schema.sql && wrangler d1 migrations apply quiztrivia --local && wrangler d1 execute quiztrivia --local --file=db/seed.generated.sql",
    "build:image-check": "node scripts/build-image-check.mjs",
    "difficulty:review": "node scripts/difficulty-review.mjs"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
