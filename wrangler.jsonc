{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiztrivia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiztrivia",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
