{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiztrivia",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SCORE_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
